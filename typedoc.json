{
  "$schema": "https://typedoc.org/schema.json",
  "out": "doc_internal",
  "json": "doc_internal/json/doc.json",
  "entryPoints": ["src/**/*.ts"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts", "**/node_modules/**"],
  "tsconfig": "tsconfig.json",
  "excludePrivate": true,
  "excludeProtected": false,
  "includeVersion": true
}
